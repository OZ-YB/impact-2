{%- comment -%} ZONÉA – Réassurance sous le bouton d'achat {%- endcomment -%}
<div class="zn-trust">
  <ul class="zn-trust__list">
    <li><span aria-hidden="true">🔒</span> Paiement 100 % sécurisé</li>
    <li><span aria-hidden="true">📦</span> Livraison suivie · FR · BE · CH</li>
    <li><span aria-hidden="true">↩️</span> Satisfait ou remboursé 30 jours</li>
    <li><span aria-hidden="true">🇫🇷</span> Marque française · SAV en français</li>
  </ul>
  <div class="zn-trust__pay">
    {%- for type in shop.enabled_payment_types -%}
      {{ type | payment_type_svg_tag: class: 'zn-trust__icon' }}
    {%- endfor -%}
  </div>
</div>
<style>
  .zn-trust { margin-top:6px; padding:14px; border-radius:14px; background:#F6F1E7; border:1px solid #E4DCCB; }
  .zn-trust__list { list-style:none; margin:0 0 10px; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:8px 12px; font-size:.82rem; font-weight:600; color:#15211D; }
  .zn-trust__list li { display:flex; gap:6px; align-items:flex-start; line-height:1.3; }
  .zn-trust__pay { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; }
  .zn-trust__icon { height:22px; width:auto; }
  @media (max-width:380px){ .zn-trust__list { grid-template-columns:1fr; } }
</style>
